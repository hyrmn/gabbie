{
	"name": "Go",
	"image": "mcr.microsoft.com/devcontainers/go:2-1.26-trixie",
	"features": {
		"ghcr.io/devcontainers/features/node:2": {
			"nodeGypDependencies": true,
			"version": "lts",
			"npmVersion": "lts",
			"pnpmVersion": "latest",
			"nvmVersion": "latest"
		},
		"ghcr.io/r3dpoint/devcontainer-features/tailwindcss-standalone-cli:1": {
			"version": "latest"
		}
	},
	"forwardPorts": [
		8080
	],
    "postCreateCommand": ".devcontainer/install-tools.sh",
	"mounts": [
		{
			"source": "${localEnv:HOME}${localEnv:USERPROFILE}/.pi/agent",
			"target": "/home/vscode/.pi/agent",
			"type": "bind"
		}
	],
	"customizations": {
		"vscode": {
			"extensions": [
				"dbaeumer.vscode-eslint",
				"esbenp.prettier-vscode"
			]
		}
	}
	// Features to add to the dev container. More info: https://containers.dev/features.
	// "features": {},
	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],
	// Use 'postCreateCommand' to run commands after the container is created.
	// "postCreateCommand": "go version",
	// Configure tool-specific properties.
	// "customizations": {},
	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}